# ==================================
# Academy Desk - Environment Variables
# ==================================

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Academy Desk"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/academy_desk?retryWrites=true&w=majority"

# Authentication
AUTH_SECRET="GENERATE_A_SECURE_RANDOM_SECRET"
AUTH_URL=http://localhost:3000

# Password recovery email delivery
RESEND_API_KEY=""
EMAIL_FROM="Academy Desk <no-reply@example.com>"

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
RATE_LIMIT_KEY_SECRET=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
